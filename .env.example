# =============================================================================
# Cursor PR Agent Loop – Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Required: Cursor API Key ---
# Generate at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=your_cursor_api_key_here

# --- Required: GitHub Personal Access Token ---
# Needs: repo, pull_requests, issues scopes
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# --- Required: GitHub repositories to watch (comma-separated) ---
# Format: owner/repo or full URL
GITHUB_REPOS=owner/repo1,owner/repo2

# --- Optional: Cursor model to use (default: composer-2) ---
CURSOR_MODEL=composer-2

# --- Optional: How often to poll for open PRs in minutes (default: 5) ---
POLL_INTERVAL_MINUTES=5

# --- Optional: Max concurrent agents per cycle (default: 3) ---
MAX_CONCURRENT_AGENTS=3

# --- Optional: Auto-merge if review passes and no open questions (default: false) ---
AUTO_MERGE=false

# --- Optional: Merge strategy when auto-merging (merge|squash|rebase, default: squash) ---
MERGE_METHOD=squash

# --- Optional: Required approvals before auto-merge (default: 1) ---
REQUIRED_APPROVALS=1

# --- Optional: Label on GitHub Issues to pick up as new agent tasks (default: agent-task) ---
TASK_LABEL=agent-task

# --- Optional: State file path (default: .agent-state.json) ---
STATE_FILE=.agent-state.json

# --- Optional: Log level (debug|info|warn|error, default: info) ---
LOG_LEVEL=info
