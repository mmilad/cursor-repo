# ─── Cursor SDK ───────────────────────────────────────────────────────────────
# Get from: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional: default git URL for cloud agent runs (--cloud flag or pr-agent daemon)
CURSOR_CLOUD_REPO_URL=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token with: repo, issues, pull_requests scopes
GITHUB_TOKEN=

# Comma-separated list of repos to watch: owner/repo,owner/repo2
GITHUB_REPOS=

# ─── PR-agent loop (npm run pr-agent) ─────────────────────────────────────────
# Cron schedule for the daemon (default: every 5 minutes)
# LOOP_CRON=*/5 * * * *

# Number of approvals required before auto-merge (default: 1)
# REQUIRED_APPROVALS=1

# Enable auto-merge after approval threshold (default: false)
# AUTO_MERGE=false

# GitHub issue label used for mobile task ingestion (default: agent-task)
# TASK_LABEL=agent-task

# Max PRs processed concurrently per cycle (default: 3)
# CONCURRENCY_LIMIT=3

# Working directory for local agent runs (default: process.cwd())
# LOCAL_CWD=/home/pi/cursor-universal-template
